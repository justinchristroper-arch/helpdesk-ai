# Local backend validation. Replace values only in ignored backend/.env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@NEON_HOST/neondb?sslmode=require&channel_binding=require
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
# Vercel automatically defaults to null; Docker/local default to queue.
DATABASE_POOL_MODE=queue

# Optional server-side synthesis. Leave unset for deterministic answers.
MINDROUTER_API_KEY=
MINDROUTER_BASE_URL=https://api.mindrouter.io/v1
MINDROUTER_MODEL=openai/gpt-4.1-nano
